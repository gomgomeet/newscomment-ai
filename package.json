{
  "name": "newscomment-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "skills:package": "node scripts/package-skills.mjs",
    "test:evaluation-review": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types lib/evaluation/build-review-queue.test.mts",
    "eval:questioning": "node scripts/run-questioning-dialogue-eval.mjs --suite=all",
    "eval:questioning:development": "node scripts/run-questioning-dialogue-eval.mjs --suite=development",
    "eval:gas": "node evals/gas/run.mjs",
    "eval:gas:parity": "node --experimental-strip-types evals/gas/parity.mjs",
    "eval:gas:e2e": "node evals/gas/e2e.mjs",
    "build:gas-lite-distribution": "node scripts/build-gas-lite-distribution.mjs",
    "test:gas-lite": "node scripts/test-gas-lite.cjs && node scripts/test-gas-lite-teacher-setup-ui.cjs && node scripts/test-lite-engine-plan.mjs && node scripts/test-simbot-branding.cjs && node scripts/test-gas-lite-distribution.cjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-questioning-chat-rate-limit.mts",
    "test:lite-engine-http": "node scripts/test-lite-engine-http.mjs",
    "check:lite-deployment": "node scripts/check-lite-deployment-preflight.mjs",
    "test:lite-deployment-preflight": "node --test scripts/test-lite-deployment-preflight.mjs",
    "eval:questioning:holdout": "node scripts/run-questioning-dialogue-eval.mjs --suite=holdout"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
