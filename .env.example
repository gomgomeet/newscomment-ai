NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key for encrypted questioning lesson connections.
# Prefer SUPABASE_SECRET_KEY. Use SUPABASE_SERVICE_ROLE_KEY only for legacy projects.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only random string used to encrypt teacher Gemini and Notion tokens.
QUESTIONING_SECRET_ENCRYPTION_KEY=

# Server-only random string used to encrypt each teacher's evaluation-dashboard Notion token.
EVALUATION_SECRET_ENCRYPTION_KEY=

# Optional password required when saving a new teacher lesson connection.
QUESTIONING_CONNECTION_SETUP_TOKEN=

# Optional server defaults. The questioning board can use teacher-entered Gemini keys instead.
# AI draft provider for the evaluation dashboard. Leave AI_EVALUATION_PROVIDER empty to use
# whichever key is set (Claude first). Set it to "anthropic" or "openai" to pin one.
AI_EVALUATION_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_EVALUATION_MODEL=claude-fable-5-1
# Optional thinking depth for Claude drafts: low | medium | high (default) | xhigh | max
ANTHROPIC_EVALUATION_EFFORT=
OPENAI_API_KEY=
OPENAI_EVALUATION_MODEL=gpt-5.6
GEMINI_API_KEY=
GEMINI_QUESTIONING_MODEL=gemini-2.5-flash

# Student conversations use the local source-bounded provider by default.
# Enable an external provider only after the school or institution approves its
# terms, privacy handling, and use with the target student age group.
QUESTIONING_STUDENT_LLM_ENABLED=false
QUESTIONING_STUDENT_PROVIDER=local

# Optional legacy/shared-demo Notion mode. The evaluation prep normally uses each teacher's
# encrypted token; questioning lessons also use teacher-entered tokens.
NOTION_API_KEY=
NOTION_API_VERSION=2022-06-28
NOTION_QUESTIONING_PREP_DATABASE_ID=
NOTION_QUESTIONING_RESULT_DATABASE_ID=
